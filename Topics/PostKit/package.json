{
  "name": "postkit",
  "version": "1.0.0",
  "private": true,
  "description": "PostKit — local-first social content scheduler (Electron Mac app)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "server": "node server.js",
    "postinstall": "electron-builder install-app-deps || true"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "better-sqlite3": "^12.11.1"
  },
  "devDependencies": {
    "electron": "^33.4.11"
  },
  "build": {
    "appId": "com.jumpkit.postkit",
    "productName": "PostKit",
    "files": [
      "main.js",
      "preload.js",
      "server.js",
      "app.js",
      "index.html",
      "style.css",
      "x-oauth.js",
      "linkedin-oauth.js",
      "lib/**/*",
      "templates/**/*",
      "assets/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "media",
        "to": "media"
      }
    ],
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.productivity",
      "darkModeSupport": true
    }
  }
}
